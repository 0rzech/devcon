{
  "[ada]": {
    "editor.defaultFormatter": "AdaCore.ada",
    "editor.tabSize": 3
  },
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.rulers": [
      80
    ],
    "editor.selectionHighlight": false,
    "editor.suggestSelection": "first",
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "off"
  },
  "acp.agents": {
    "Goose": {
      "args": ["acp"],
      "command": "goose",
      "env": {}
    }
  },
  "acp.autoApprovePermissions": "ask",
  "ada.defaultCharset": "utf-8",
  "C_Cpp.copilotHover": "disabled",
  "chat.agent.enabled": false,
  "chat.checkpoints.showFileChanges": true,
  "chat.commandCenter.enabled": false,
  "chat.customAgentInSubagent.enabled": false,
  "chat.disableAIFeatures": true,
  "chat.editor.fontSize": 16,
  "chat.extensionTools.enabled": false,
  "chat.fontSize": 16,
  "chat.mcp.access": "none",
  "chat.mcp.apps.enabled": false,
  "continue.disableQuickFix": true,
  "continue.enableNextEdit": false,
  "continue.enableTabAutocomplete": false,
  "continue.telemetryEnabled": false,
  "dart.closeDevTools": "ifOpened",
  "dart.closingLabelsTextStyle": "italic",
  "dart.devToolsTheme": "light",
  "dart.flutterGenerateLocalizationsOnSave": "manualIfDirty",
  "debug.console.fontSize": 16,
  "diffEditor.experimental.showEmptyDecorations": false,
  "diffEditor.hideUnchangedRegions.enabled": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": true,
  "editor.experimental.treeSitterTelemetry": false,
  "editor.foldingImportsByDefault": true,
  "editor.fontFamily": "'Fira Code', 'Source Code Pro', 'Droid Sans Mono', 'monospace', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 16,
  "editor.formatOnSave": true,
  "editor.lineNumbers": "relative",
  "editor.minimap.autohide": "mouseover",
  "evenBetterToml.formatter.columnWidth": 300,
  "explorer.autoReveal": false,
  "extensions.autoUpdate": "off",
  "files.insertFinalNewline": true,
  "files.watcherExclude": {
    "**/.ammonite": true,
    "**/.bloop": true,
    "**/.dart_tool/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.metals": true,
    "**/build/**": true,
    "**/target/**": true
  },
  "git.alwaysShowStagedChangesResourceGroup": true,
  "git.autoStash": true,
  "git.openRepositoryInParentFolders": "never",
  "github.copilot.enable": {
    "*": false,
    "markdown": false,
    "plaintext": false,
    "scminput": false
  },
  "githubPullRequests.fileListLayout": "tree",
  "gitlab.aiAssistedCodeSuggestions.enabled": false,
  "gitlab.duoChat.enabled": false,
  "gitlens.ai.enabled": false,
  "gitlens.telemetry.enabled": false,
  "js/ts.tsserver.checkNpmIsInstalled": false,
  "markdown.preview.fontSize": 16,
  "material-icon-theme.activeIconPack": "none",
  "notebook.lineNumbers": "on",
  "python.experiments.enabled": false,
  "python.languageServer": "Default",
  "quarkus.tools.alwaysShowWelcomePage": false,
  "redhat.telemetry.enabled": false,
  "rust-analyzer.debug.openDebugPane": true,
  "sarif-viewer.connectToGithubCodeScanning": "off",
  "scm.inputFontSize": 16,
  "search.showLineNumbers": true,
  "sqltools.connectionExplorer.groupConnected": true,
  "sqltools.format": {
    "linesBetweenQueries": 2
  },
  "sqltools.results.reuseTabs": "connection",
  "sqltools.sortColumns": "ordinalnumber",
  "telemetry.editStats.details.enabled": false,
  "telemetry.editStats.enabled": false,
  "telemetry.feedback.enabled": false,
  "telemetry.performance.inputLatencySamplingProbability": 0,
  "telemetry.telemetryLevel": "off",
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.defaultProfile.linux": "fish",
  "terminal.integrated.enableKittyKeyboardProtocol": false,
  "terminal.integrated.fontFamily": "'Source Code Pro'",
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.hideOnLastClosed": false,
  "terminal.integrated.inheritEnv": false,
  "terminal.integrated.initialHint": false,
  "terminal.integrated.minimumContrastRatio": 1,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.shellIntegration.enabled": false,
  "update.mode": "none",
  "update.showReleaseNotes": false,
  "vim.highlightedyank.enable": true,
  "vim.smartRelativeLine": true,
  "vsicons.dontShowNewVersionMessage": true,
  "window.customTitleBarVisibility": "auto",
  "window.dialogStyle": "custom",
  "window.menuBarVisibility": "classic",
  "window.titleBarStyle": "custom",
  "window.zoomLevel": 0.75,
  "workbench.colorTheme": "Selene Selenized Light",
  "workbench.enableExperiments": false,
  "workbench.externalBrowser": "firefox-flatpak",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.preferredDarkColorTheme": "Selene Selenized Dark",
  "workbench.preferredLightColorTheme": "Selene Selenized Light",
  "workbench.reduceMotion": "on",
  "workbench.settings.showAISearchToggle": false,
  "workbench.startupEditor": "none",
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ]
}
